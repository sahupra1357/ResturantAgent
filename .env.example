# Copy to .env and fill in.
# LLM_MODE: "live" | "mock". Empty = live if the selected provider has an API key, else mock (rule-based agents).
LLM_MODE=live

# LLM_PROVIDER: meta (default) | openai | anthropic | ollama
LLM_PROVIDER=meta
# Optional override of the provider's default model: a bare name, or "provider:model" (e.g. openai:gpt-4.1)
LLM_MODEL=muse-wonder-1.0

# Meta Model API (https://dev.meta.ai/docs). MODEL_API_KEY / LLAMA_API_KEY are also accepted.
META_API_KEY=LLM_..
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
# Optional reasoning effort for Muse Spark (e.g. low / medium / high); empty = API default
META_REASONING_EFFORT=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Ollama (local, no key)
OLLAMA_MODEL=llama3.1

# Optional LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=restaurant-ops
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Forecast training aborts when process memory exceeds this (MB); 0 = no limit
TRAIN_MAX_MEMORY_MB=4096

# --- live service ---
# EVENT_BUS: auto (Redis Streams when REDIS_URL answers, else in-process) | redis | memory
EVENT_BUS=auto
REDIS_URL=redis://localhost:6379/0
# --- identity: named users with roles (admin / manager / server / kitchen). AUTH_ENABLED=false turns sign-in off.
AUTH_ENABLED=true
# First admin: set a password here, or leave empty and read the generated one from data/FIRST_RUN_ADMIN.txt
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Demo accounts manager/manager-demo, server/server-demo, kitchen/kitchen-demo. Turn off anywhere real.
DEMO_USERS=true
SESSION_HOURS=12
# true when served over HTTPS (the session cookie is then Secure)
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MIN=5

# --- payments: simulated | stripe
PAYMENT_PROCESSOR=simulated
STRIPE_SECRET_KEY=
CURRENCY=usd

# --- purchase orders by e-mail (empty SMTP_HOST: PDF + .eml wait in data/outbox/)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_FROM=orders@restaurant.example

# --- kitchen printer: file (data/printer/) | tcp (ESC/POS network printer on port 9100) | off
PRINTER_MODE=file
PRINTER_HOST=
# per-station override, e.g. PRINTER_HOST_GRILL=10.0.0.21
KDS_LATE_MIN=20

# --- backups and snapshots
BACKUP_KEEP=14
SNAPSHOT_KEEP=3

# --- LLM pilot limits (per service); exceeding any falls back to the rule-based proposals
LLM_TIMEOUT_S=12
# SDK retries inside that budget (0: a retry rarely fits; the proposal falls back to rules instead)
LLM_MAX_RETRIES=0
# Meta reasoning effort for the live review only (the batch agents use META_REASONING_EFFORT); empty = API default
META_REVIEW_REASONING_EFFORT=low
LLM_MAX_CALLS_PER_SERVICE=150
LLM_MAX_COST_PER_SERVICE=2.0
LLM_PRICE_IN_PER_MTOK=3.0
LLM_PRICE_OUT_PER_MTOK=15.0
LLM_BREAKER_FAILURES=3
# Approval timeout in service minutes (a paused clock freezes it)
APPROVAL_TIMEOUT_SIM_MIN=20
# Structured logs and retention
LOG_JSON=false
LIVE_RETENTION_DAYS=14
LIVE_KEEP_LAST=20
# Resume an interrupted service when the server starts
RESUME_ON_START=true
